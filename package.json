{
  "name": "gas-inquiry-web-form",
  "version": "0.0.0",
  "private": true,
  "description": "Inquiry web form with Google Apps Script",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "audit": "pnpm audit",
    "audit:fix": "pnpm audit --fix=override",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "push": "clasp push",
    "deploy": "clasp deploy",
    "all": "pnpm run format && pnpm run lint:fix && pnpm run typecheck && pnpm run test && pnpm run audit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dceoy/gas-inquiry-web-form.git"
  },
  "keywords": [
    "google-apps-script",
    "gas",
    "inquiry-form",
    "clasp"
  ],
  "license": "AGPL-3.0",
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@google/clasp": "3.4.1",
    "@types/node": "26.6.4",
    "oxlint": "^1.86.0",
    "typescript": "7.0.2"
  }
}
